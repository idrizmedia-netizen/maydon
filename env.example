# 1) Sayt manzili (sitemap, RSS va ulashish havolalari uchun)
NEXT_PUBLIC_SITE_URL=https://sizning-domeningiz.uz

# 2) Admin panel: sessiyani imzolash uchun uzun tasodifiy matn (kamida 16 belgi).
#    Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# 3) Ma'lumotlar bazasi (Vercel Storage'dan Upstash Redis ulasangiz, bu ikkisi o'zi qo'shiladi).
#    Kompyuterda (npm run dev) kerak emas.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 4) Google bilan kirish (majburiy - admin panelga boshqa kirish yo'li yo'q).
#    Yaratish: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID (Web application).
#    Authorized redirect URI: https://SAYTINGIZ/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 5) Google orqali kirishga ruxsat beriladigan yagona email.
#    Bo'sh qoldirilsa, standart qiymat idrizmedia@gmail.com ishlatiladi.
ADMIN_GOOGLE_EMAIL=idrizmedia@gmail.com
