# Sayt manzili (sitemap, RSS va ulashish havolalari uchun).
# Vercel'da: Project Settings -> Environment Variables ga qo'shing.
NEXT_PUBLIC_SITE_URL=https://sizning-domeningiz.uz
# 1) Sayt manzili (sitemap, RSS va ulashish havolalari uchun)
NEXT_PUBLIC_SITE_URL=https://sizning-domeningiz.uz

# 2) Admin panel: sessiyani imzolash uchun uzun tasodifiy matn (kamida 16 belgi).
#    Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# 3) Admin login va parol. Bo'sh qoldirilsa, VAQTINCHALIK Izzat / 123456 ishlaydi.
#    Sayt internetga chiqqach, albatta o'zgartiring.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# 4) Ma'lumotlar bazasi (Vercel Storage'dan Upstash Redis ulasangiz, bu ikkisi o'zi qo'shiladi).
#    Kompyuterda (npm run dev) kerak emas.
KV_REST_API_URL=
KV_REST_API_TOKEN=
